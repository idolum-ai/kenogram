{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idolum.ai/kenogram/schemas/kenogram.job-evidence-manifest.v1.schema.json",
  "title": "Kenogram governed job evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "request_sha256", "result_sha256", "content_sha256", "sealed_at", "entries"],
  "properties": {
    "schema": {"const": "kenogram.job-evidence-manifest.v1"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "result_sha256": {"$ref": "#/$defs/digest"},
    "content_sha256": {"$ref": "#/$defs/digest"},
    "sealed_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 10032,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/\\u0000][^\\u0000]*$"},
        "kind": {"enum": ["request", "declaration", "plan", "provenance", "runtime", "stdout", "stderr", "result", "target_inventory", "target_artifact"]},
        "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
